# SiteDocs API — local development environment
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# `python-dotenv` loads this automatically when running `python -m etl.run_etl`.

# ---------------------------------------------------------------------------
# PostgreSQL (required for all ETL stages)
# ---------------------------------------------------------------------------
POSTGRES_HOST=your-pg-host.postgres.database.azure.com
POSTGRES_DB=sitedocs
POSTGRES_USER=sitedocs_app
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# SiteDocs API (required for all ETL stages except `--dry-run`)
# Bearer token — include the "Bearer " prefix if your token needs it.
# ---------------------------------------------------------------------------
SITEDOCS_API_TOKEN=replace-me
SITEDOCS_COMPANY_ID=48651caf-50e4-45ab-875a-dfe02fa14441

# ---------------------------------------------------------------------------
# API auth (only needed when running function_app.py locally with `func start`)
# ---------------------------------------------------------------------------
API_KEY=replace-me-local-dev-key

# ---------------------------------------------------------------------------
# Key Vault (leave false for local dev — reads secrets from this .env instead)
# ---------------------------------------------------------------------------
USE_KEY_VAULT=false
# KEY_VAULT_URL=https://your-kv.vault.azure.net/

# ---------------------------------------------------------------------------
# SharePoint PDF sync (only needed if you run the hourly_pdf_sync timer locally)
# ---------------------------------------------------------------------------
# SP_TENANT_ID=
# SP_CLIENT_ID=
# SP_CLIENT_SECRET=
